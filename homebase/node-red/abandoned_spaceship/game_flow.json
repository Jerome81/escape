    {
        "id": "af756602358187d1",
        "type": "function",
        "z": "3a0b50343819716a",
        "name": "format time",
        "func": "var t = msg.timeRemaining;\nt = t / 1000;\nvar h = Math.floor(t / 3600);\nvar m = Math.floor(t % 3600 / 60);\nvar s = Math.floor(t % 3600 % 60);\n\nif (h > 0) {\n    msg.formattedTimeRemaining = (\"0\" + h).slice(-2) + \":\" + (\"0\" + m).slice(-2);\n} else {\n    if (m > 0) {\n        msg.formattedTimeRemaining = m + \" min\";\n    } else {\n        msg.formattedTimeRemaining = s + \" sec\";\n    }\n}\n\nmsg.oxygenRemaining = Math.floor(t * 100000 / global.get(\"timeForRoom\"));\n\nnode.status({fill: \"green\", shape:\"dot\", text:msg.oxygenRemaining});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 300,
        "wires": [
            [
                "ba6b218d01d3d0e2"
            ]
        ]
    },
