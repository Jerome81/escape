    {
        "id": "fbe9267cb592d891",
        "type": "function",
        "z": "3a0b50343819716a",
        "name": "GameLogic",
        "func": "/**\n * This function gets called:\n * 1. When time has passed (every second) for which it receives:\n *  - msg.timeRemaining\n *  - msg.formattedTimeRemaining\n *  - msg.oxygenRemaining (0 - 100 - x % of 1 h)\n * \n * 2. A message was received (ToDevice/All).\n */\n\nlet dockdoorunlocked = global.get(\"DockDoorUnlocked\") || false;\nmsg.payload.dockdoorunlocked = dockdoorunlocked;\n//node.status({fill: \"green\", shape:\"dot\", text:dockdoorunlocked});\n\nif (msg.payload.event != null) {\n    node.status({fill: \"green\", shape:\"dot\", text:msg.payload.event});\n\n    if (msg.payload.event == \"Dock door unlocked\") {\n        global.set(\"DockDoorUnlocked\", true);\n        msg.payload.dockdoorunlocked = global.get(\"DockDoorUnlocked\") || false;\n    }\n    if (msg.payload.event == \"Mystery solved\") {\n        msg.event = \"lightcontroller\";\n        flow.set(\"effect\", \"rain\");\n        node.status({fill: \"green\", shape:\"dot\", text:msg.event});\n    }\n    \n    if (msg.payload.event == \"Self destruct\") {\n        msg.event = \"lightcontroller\";\n        flow.set(\"effect\", \"broken\");\n        node.status({fill: \"green\", shape:\"dot\", text:msg.event});\n    }\n    \n    if (msg.payload.event == \"Core removed\") {\n        msg.event = \"lightcontroller\";\n        flow.set(\"effect\", \"rain\");\n        node.status({fill: \"green\", shape:\"dot\", text:msg.event});\n    }\n    \n    return msg;\n} else {\n\n    // After a few seconds, start intruder alarm\n    if (msg.timeRemaining > 3585000 && msg.timeRemaining < 3600000) {\n        if (! (global.get(\"IntruderAlert\") || false)) {\n            global.set(\"IntruderAlert\", true);\n            msg.topic = \"ToDevice/All\";\n            msg.event = \"Intruder alert\";\n            return msg;\n        }\n    }\n\n    // These events only happen if the dock door is still locked.\n    if (! dockdoorunlocked) {\n        // After about 3 minutes, automatically trigger Ripplis hint\n        if (msg.timeRemaining > 3420000 && msg.timeRemaining < 3422000) {\n        //if (msg.timeRemaining > 3590000 && msg.timeRemaining < 3592000) {\n            if (! (global.get(\"RipplisHint\") || false)) {\n                global.set(\"RipplisHint\", true);\n                node.status({ fill: \"green\", shape: \"dot\", text: \"Trigger Ripplis Hint\" });\n                msg.topic = \"ToDevice/All\";\n                msg.event = \"Ripplis hint\";\n            }\n            return msg;\n        }\n        \n        // After 4 min, trigger AI warning\n        if (msg.timeRemaining > 3360000 && msg.timeRemaining < 3362000) {\n            if (! (global.get(\"AIWarning\") || false)) {\n                global.set(\"AIWarning\", true);\n                msg.topic = \"ToDevice/All\";\n                msg.event = \"AI warning\";\n                return msg;\n            }\n        }\n\n        // After 4 min 40, trigger help from ISS RIDDLE\n        if (msg.timeRemaining > 3320000 && msg.timeRemaining < 3322000) {\n            if (!(global.get(\"ISSHelp\") || false)) {\n                global.set(\"ISSHelp\", true);\n                msg.topic = \"ToDevice/All\";\n                msg.event = \"ISS Riddle intervention\";\n                return msg;\n            }\n        }\n    }\n    return null;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 950,
        "y": 500,
