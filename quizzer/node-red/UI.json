    {
        "id": "8cb2dcce433b4f08",
        "type": "function",
        "z": "49590b83b2d0e982",
        "name": "Set Players",
        "func": "msg.payload.station_1 = flow.get(\"station_1\") || \"\";\nmsg.payload.station_2 = flow.get(\"station_2\") || \"\";\nmsg.payload.station_3 = flow.get(\"station_3\") || \"\";\nmsg.payload.station_4 = flow.get(\"station_4\") || \"\";\nmsg.payload.station_5 = flow.get(\"station_5\") || \"\";\nmsg.payload.station_6 = flow.get(\"station_6\") || \"\";\n\nvar players = \"\";\nif ((flow.get(\"station_1\") || \"\") != \"\") {\n    players = players + \"1\";\n    global.set(\"players_1\", null);\n}\nif ((flow.get(\"station_2\") || \"\") != \"\") {\n    players = players + \"2\";\n    global.set(\"players_2\", null);\n}\nif ((flow.get(\"station_3\") || \"\") != \"\") {\n    players = players + \"3\";\n    global.set(\"players_3\", null);\n}\nif ((flow.get(\"station_4\") || \"\") != \"\") {\n    players = players + \"4\";\n    global.set(\"players_4\", null);\n}\nif ((flow.get(\"station_5\") || \"\") != \"\") {\n    players = players + \"5\";\n    global.set(\"players_5\", null);\n}\nif ((flow.get(\"station_6\") || \"\") != \"\") {\n    players = players + \"6\";\n    global.set(\"players_6\", null);\n}\nglobal.set(\"players\", players);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 460,
        "wires": [
