    {
        "id": "8bd5b233c50200cf",
        "type": "function",
        "z": "852d5bc711a1f34f",
        "name": "NeueFrage",
        "func": "if (global.get(\"status\") != \"Neue Frage\") {\n    return;\n}\n\nvar players = global.get(\"players\");\nglobal.set(\"status\", \"Warte auf Antwort von \" + players);\nglobal.set(\"waiting_for\", players);\n\nvar questions = global.get(\"current_questions\");\nvar current_question = global.get(\"current_question\");\n\ncurrent_question = current_question + 1;\nif (current_question >= Object.keys(questions).length) {\n    global.set(\"status\", \"Neue Sektion\");\n    return;\n}\n\nvar question = questions[current_question];\n\nglobal.set(\"current_question\", current_question);\n\n\nmsg.payload = {\n    \"question\": question\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
