        "func": "var missingPlayers = global.get(\"waiting_for\") || \"\";\nvar players = global.get(\"players\") || \"\";\nglobal.set(\"status\", \"Auswertung erfolgreich - warte auf: \" + missingPlayers);\n\nvar status = global.get(\"status\") || \"\"; \nnode.status({ fill: \"red\", shape: \"ring\", text: status });\n\nif (status == \"\" || players == \"\") {\n    return null;\n}\n\nif (!status.startsWith(\"Auswertung erfolgreich\")) {\n    return null;\n}\n\nif (missingPlayers == \"\") {\n    global.set(\"status\", \"Neue Frage\");\n} else {\n    global.set(\"status\", \"Auswertung erfolgreich - warte auf: \" + missingPlayers);\n}\n\n\nreturn msg;",
