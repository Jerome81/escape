        "func": "var missingPlayers = global.get(\"waiting_for\") || \"\";\nvar players = global.get(\"players\") || \"\";\nvar status = global.get(\"status\") || \"\";\n\nnode.status({ fill: \"red\", shape: \"ring\", text: status });\n\nif (status == \"\" || players == \"\") {\n    return null;\n}\n\nif (!status.startsWith(\"Warte auf Spieler\")) {\n    return null;   \n}\n\nif (missingPlayers == \"\") {\n    global.set(\"status\", \"Spiel gestartet\");\n} else {\n    global.set(\"status\", \"Warte auf Spieler \" + missingPlayers);\n}\n\n\nreturn msg;",
