    {
        "id": "cb66ce3bc4f530d1",
        "type": "function",
        "z": "852d5bc711a1f34f",
        "name": "AuswertenEveryone",
        "func": "var answers = global.get(\"answers\");\nvar questionNumber = global.get(\"current_question\");\nvar question = global.get(\"current_questions\")[questionNumber];\nvar players = global.get(\"players\");\n\nvar correctAnswer = question[\"answer\" + question.correctAnswer];\nfor (var i = 0; i < players.length; i++) {\n    var playerNumber = players.substring(i, i + 1) \n    var player = global.get(\"player_\" + playerNumber) || {};\n    var score = player[\"score\"] || []\n    node.status({ fill: \"green\", shape: \"circle\", text: answers[playerNumber] });\n\n    if (answers[playerNumber] == correctAnswer) {\n        score.push(100);\n        player[\"correct\"] = true;\n    } else {\n        score.push(0);\n        player[\"correct\"] = false;\n    }\n    var total = 0;\n    for (var points in score) {\n        total = total + score[points];\n    }\n    player.score = score; \n    player.correctAnswer = correctAnswer;\n    player.explanation = \"EXPLANATION\";\n    player[\"total\"] = total;\n    global.set(\"player_\" + playerNumber, player);\n}\nreturn msg;",
