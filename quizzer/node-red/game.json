        "type": "function",
        "z": "852d5bc711a1f34f",
        "name": "NeueSektion",
        "func": "var sections = global.get(\"current_sections\");\nvar current_section = global.get(\"current_section\");\n\nif (current_section >= Object.keys(sections).length) {\n    global.set(\"status\", \"Quiz Fertig\");\n    return null;\n}\n\nvar section = sections[current_section];\nglobal.set(\"current_questions\", section.questions);\n\nsection.totalQuestions = section.questions.length;\nsection.questions = \"REMOVED\";\n\nmsg.payload = {\n    \"section\": section\n}\n\nglobal.set(\"current_section\", current_section + 1);\nglobal.set(\"status\", \"Sektionsinfo\");\nglobal.set(\"current_question\", -1);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
