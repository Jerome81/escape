    {
        "id": "4660790fd9dcef84",
        "type": "function",
        "z": "852d5bc711a1f34f",
        "name": "Questions to global",
        "func": "var selected = global.get(\"quiz\");\nfor (var quiz in msg.payload) {\n    if (quiz == selected) {\n        var current = msg.payload[quiz];\n        global.set(\"current_sections\", current.sections);\n        global.set(\"current_question\", -1);\n        global.set(\"current_section\", 0);\n        global.set(\"status\", \"Neue Sektion\");\n        return msg;\n    }\n}\nglobal.set(\"status\", \"Quiz: \" + selected + \" nicht gefunden.\");\nreturn null;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
