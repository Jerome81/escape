        "name": "AnswerReceived",
        "func": "var player = msg.fromPlayer;\nvar waiting = global.get(\"waiting_for\");\nwaiting = waiting.replace(player, \"\");\nglobal.set(\"waiting_for\", waiting);\n\n\nif (waiting == \"\") {\n    global.set(\"status\", \"Antworten auswerten\");\n} else {\n    var status = global.get(\"status\");\n    status = status.replace(player, \"\");\n    global.set(\"status\", status);\n}\n\nvar answer = msg.payload;\nanswer = answer.replace(\"Answer: \", \"\");\nnode.status({ fill: \"green\", shape: \"circle\", text: player });\n\nvar answers = global.get(\"answers\") || {};\nanswers[player] = answer;\nglobal.set(\"answers\", answers);\n\nreturn msg;",
